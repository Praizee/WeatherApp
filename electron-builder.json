{
  "appId": "com.weatherapp.desktop",
  "productName": "Weather App",
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb",      "arch": ["x64"] },
      { "target": "tar.gz",   "arch": ["x64"] }
    ],
    "icon": "assets/images/icon.png",
    "category": "Utility"
  },
  "directories": {
    "output": "release"
  },
  "extraMetadata": {
    "main": "electron/main.js"
  }
}
